.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcuserstate
__pycache__/
*.pyc
.venv/
code/voice-worker/.venv/
dev-docs/refs/code/**/.git

# 安装包里的模型资产不进仓库：weights.safetensors 单文件 513MB，超过 GitHub 的单文件上限。
code/Client/dist/Squirrel.app/Contents/Resources/Models/
code/Client/dist/Squirrel.app/Contents/Resources/mlx.metallib

# Rust 构建产物。
code/voice-engine/target/

# 参考克隆各有自己的 .git，按目录整体排除，避免被当成内嵌仓库。
dev-docs/refs/code/
*.tmp

# 封装的中间目录不进仓库；归档与哈希要进，方便直接下载。
/dist/RimeClient-*/
/dist/*.tar.zst
/dist/*.sha256
!/dist/RimeClient-*.tar.zst
!/dist/RimeClient-*.sha256

# 封装用的中间展开目录（含 400 MB gram 与 500 MB 权重），只留 Release 资产。
/dist/models/
/dist/rime-config/
/installation.yaml
